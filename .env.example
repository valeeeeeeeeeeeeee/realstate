# Copie para .env e preencha. O .env nunca vai para o git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=0

# SMTP. Sem EMAIL_HOST, os e-mails só aparecem no console.
# Gmail: smtp.gmail.com, porta 587, com uma "senha de app".
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Imobiliária <avisos@exemplo.com.br>
